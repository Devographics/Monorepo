---
import { fetchGraphQLApi } from '@devographics/fetch'
import type { Entity } from '@devographics/types'

const QUERY = `
query MyQuery {
  entities(tags: "video_creators") {
    id
    name
    twitter {
      url
    }
    bluesky {
      url
    }
    youtube {
      url
      stats {
        subscribers
      }
    }
  }
}
`

const apiUrl = import.meta.env.API_URL

let entities: Entity[] = []
let error: string | null = null

if (!apiUrl) {
    error = 'API_URL environment variable is not set'
} else {
    try {
        const data = await fetchGraphQLApi<{ entities: Entity[] }>({
            query: QUERY,
            apiUrl
        })
        entities = (data?.entities ?? [])
            .slice()
            .sort(
                (a, b) =>
                    (b.youtube?.stats?.subscribers ?? -1) - (a.youtube?.stats?.subscribers ?? -1)
            )
    } catch (e: any) {
        error = e.message
    }
}
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Video Creators</title>
    </head>
    <body>
        <h1>Video Creators</h1>
        {error && <p class="error">Error: {error}</p>}
        <ol>
            {
                entities.map((entity, i) => {
                    const { name, id, youtube, twitter, bluesky } = entity
                    const url = youtube?.url
                    const subscribers = entity.youtube?.stats?.subscribers
                    return (
                        <div>
                            <h3>
                                {i}. {name}
                            </h3>
                            <ul>
                                {typeof subscribers === 'number' && (
                                    <li>
                                        {' '}
                                        <a href={url} target="_blank" rel="noopener noreferrer">
                                            YouTube – {subscribers.toLocaleString()} subscribers
                                        </a>
                                    </li>
                                )}
                                {twitter && (
                                    <li>
                                        <a
                                            href={twitter.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            Twitter
                                        </a>
                                    </li>
                                )}

                                {bluesky && (
                                    <li>
                                        <a
                                            href={bluesky.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            Bluesky
                                        </a>
                                    </li>
                                )}
                            </ul>
                        </div>
                    )
                })
            }
        </ol>
    </body>
</html>

<style>
    body {
        font-family: system-ui, sans-serif;
        max-width: 40rem;
        margin: 2rem auto;
        padding: 0 1rem;
    }
    .error {
        color: crimson;
    }
    ol {
        padding-left: 1.5rem;
    }
    li {
        margin-bottom: 0.5rem;
    }
</style>
