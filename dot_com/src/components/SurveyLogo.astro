---
import { getSurveyIcon } from '@devographics/icons/surveys'

interface Props {
    surveyId: string
    name: string
}
const { surveyId, name } = Astro.props
const Icon = getSurveyIcon(surveyId)
---

<span class="logo" role="img" aria-label={name}>
    {Icon ? <Icon /> : <span class="logo-fallback">{name}</span>}
</span>

<style>
    .logo {
        display: grid;
        place-items: center;
        width: 100%;
        height: 100%;
        color: var(--accent, var(--text));
    }
    /* fit within the box whatever the logo's aspect ratio */
    .logo :global(svg) {
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 100%;
    }
    /* shared logos only define shapes, color comes from the survey accent */
    .logo :global(path) {
        fill: currentColor;
    }
    .logo-fallback {
        font-weight: 700;
        text-align: center;
        text-transform: uppercase;
    }
</style>
